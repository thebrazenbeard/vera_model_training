  "quantization": {
    "load_in_4bit": true,
    "type": "nf4",
    "double_quant": true,
    "compute_dtype": "bfloat16"
  },
  "lora": {
    "r": 4,
    "alpha": 16,
    "dropout": 0,
    "target_modules": "all-linear"
  },
  "artifact_policy": {
    "fresh_adapter_only": true,
    "parent_adapter": null,
    "save_strategy": "final_adapter_only",
    "validation_checkpoint_selection": false
  }
}
