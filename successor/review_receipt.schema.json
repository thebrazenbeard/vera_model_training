{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vera V3 hostile review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_role",
    "reviewer_lane",
    "reviewer_registration_digest",
    "candidate_digest",
    "qualification_source_commit",
    "verdict",
    "blocking_findings",
    "nonblocking_findings",
    "review_record_commit",
    "review_record_path",
    "review_record_digest"
  ],
  "properties": {
    "review_role": {
      "type": "string",
      "enum": ["RADICAL_HOSTILE", "PRAGMATIC_HOSTILE"]
    },
    "reviewer_lane": {"type": "string", "minLength": 1},
    "reviewer_registration_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qualification_source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "PASS_WITH_NONBLOCKING_FINDINGS", "FAIL"]
    },
    "blocking_findings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "nonblocking_findings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "review_record_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "review_record_path": {"type": "string", "minLength": 1},
    "review_record_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
